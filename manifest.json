{
  "manifest_version": 3,
  "name": "Global Hotkeys for Hotmart Video Player",
  "version": "0.1",
  "description": "Play/Pause or seek by 10 seconds in Hotmart videos without changing focus",
  "permissions": ["tabs", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://player.hotmart.com/*"],
      "js": ["content.js"],
      "all_frames": true
    }
  ],
  "commands": {
    "play_pause": {
      "suggested_key": {
        "default": "MediaPlayPause"
      },
      "description": "Play/Pause the video",
      "global": true
    },
    "jump_forward": {
      "suggested_key": {
        "default": "MediaNextTrack"
      },
      "description": "Jump forward in the video",
      "global": true
    },
    "jump_backward": {
      "suggested_key": {
        "default": "MediaPrevTrack"
      },
      "description": "Jump backward in the video",
      "global": true
    }
  }
}
